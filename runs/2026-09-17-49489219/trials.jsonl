r_authority_changed","outcome":"prevented"},"oracle_verdict":"authorized","outcome":"prevented","proof_state":"manual_review_required"},"spec_version":"crossplane-dogwood.v1","status":"scored","trace_shape_sha256":"2849e92316163e263613c187c9f70e2ecc8e2f958c9d81dd82dbdd3cf42343c5","trap":null,"tree_sha":"49489219795d6bea7b534a486d700c7f9b901e7f","trial_class":"T1","trial_id":"T1-F5-approver-revoked-001"}
